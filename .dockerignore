# Keep the Docker build context lean and force a clean in-container frontend
# build (local node_modules/dist are platform-specific and are regenerated by
# `npm ci` + `npm run build:web` inside the image anyway).
.git/
.idea/
.vscode/
target/
build/
*.jar
*.log

frontend/node_modules/
frontend/dist/

desktop/

.mvn/
mvnw
mvnw.cmd
