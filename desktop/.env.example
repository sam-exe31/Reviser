# Desktop local secrets — COPY this file to `desktop/.env` and fill in real values.
# desktop/.env is git-ignored and is read by desktop/main.js at startup, then
# passed to the Spring Boot backend as environment variables. Never commit the
# real .env.

# Google Gemini API key (get one at https://aistudio.google.com/apikey).
# Without this, chat falls back to offline/canned responses.
GEMINI_API_KEY=AQ.Ab8RN6KI-0eo3tX_F9psGFlH2Ax2qWePgdJKktkr-rAZcoyBr

# Optional: override the Gemini model id if the default is unavailable for your key.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: override the local PostgreSQL connection (defaults shown).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Reviser
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgresql
