{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reviser-app",
      "url": "http://localhost:8080",
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "template-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4599", "--directory", "template"],
      "port": 4599
    }
  ]
}
