### VS Code ###
.vscode/

# --- Build output ---
target/
build/
*.class

# --- Bundled / packaged artifacts (regenerated by the build; older ones may
#     embed secrets, so they must never be committed) ---
*.jar
desktop/dist-app/
desktop/dist-frontend/

# --- Node / Vite ---
node_modules/
frontend/node_modules/
frontend/dist/
desktop/node_modules/

# --- Secrets & local env overrides ---
# application.properties is committed as a SECRET-FREE template (every secret
# is read from an env var). Real values live in the environment, or in a local
# untracked override:
application-local.properties
.env
.env.local
.env.*.local

# --- Logs ---
*.log
